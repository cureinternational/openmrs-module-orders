<?xml version="1.0" encoding="UTF-8"?>

<!-- Beans to add to the current Application context definition -->

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-3.0.xsd">

    <context:component-scan base-package="org.openmrs.module.orders.api.events"/>

    <!-- Async executor for order task processing -->
    <bean id="orderTaskExecutor" class="org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor">
        <property name="corePoolSize" value="2"/>
        <property name="maxPoolSize" value="5"/>
        <property name="queueCapacity" value="100"/>
        <property name="threadNamePrefix" value="order-task-"/>
        <property name="waitForTasksToCompleteOnShutdown" value="true"/>
        <property name="awaitTerminationSeconds" value="30"/>
    </bean>

    <!-- DAO Beans -->
    <bean id="hibernateOrderTaskDao" class="org.openmrs.module.orders.api.dao.impl.HibernateOrderTaskDao">
        <property name="sessionFactory" ref="sessionFactory"/>
    </bean>

    <!-- Service Beans -->
    <bean id="orderTaskServiceImpl" class="org.openmrs.module.orders.api.service.impl.OrderTaskServiceImpl">
        <property name="orderTaskDao" ref="hibernateOrderTaskDao"/>
        <property name="conceptService" ref="conceptService"/>
    </bean>
    <bean id="orderTaskService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
        <property name="transactionManager" ref="transactionManager"/>
        <property name="target" ref="orderTaskServiceImpl"/>
        <property name="preInterceptors" ref="serviceInterceptors"/>
        <property name="transactionAttributeSource" ref="transactionAttributeSource"/>
    </bean>

</beans>
